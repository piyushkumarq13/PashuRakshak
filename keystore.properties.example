# Copy this file to keystore.properties and point it at your release keystore.
# Never commit keystore.properties or the .jks itself.
#
# Generate a keystore with:
#   keytool -genkeypair -v -keystore keystore/pashurakshak-release.jks \
#     -alias pashurakshak -keyalg RSA -keysize 4096 -validity 10000
storeFile=keystore/pashurakshak-release.jks
storePassword=CHANGE_ME
keyAlias=pashurakshak
keyPassword=CHANGE_ME
