# Copy this file to .env and fill in real values. Never commit .env.

# Remote Turso database (libSQL). For purely local development you may use a
# file URL instead, e.g. TURSO_DATABASE_URL=file:local.db (still needs a token value).
TURSO_DATABASE_URL=libsql://your-db-name.turso.io
TURSO_AUTH_TOKEN=your-turso-auth-token

# HTTP port the server listens on.
PORT=3000

# Comma-separated list of origins allowed by CORS. 5173 = vet-registration,
# 5174 = gov-portal, 3000 = backend itself. Use * to allow every origin
# (useful while the web URLs are still changing).
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:5174

# Shared secret for admin-only core routes (sent as the X-Admin-Secret header).
# Used by POST/GET /api/v1/core/apps. Generate with: openssl rand -hex 32
ADMIN_SECRET=change-me-to-a-long-random-string

# Firebase service account JSON as ONE line (quotes inside escaped or the whole
# value wrapped in double quotes). Source: Firebase Console → Project Settings →
# Service Accounts → Generate new private key.
# MUST be the SAME Firebase project the Android apps use (their google-services.json).
# Used ONLY for FCM push (device tokens + cluster alerts). Login does NOT use
# Firebase — sessions are HMAC tokens signed with SESSION_SECRET. Optional:
# without it the server starts and push helpers skip gracefully.
FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"your-project","private_key_id":"...","private_key":"-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n","client_email":"firebase-adminsdk-xxxxx@your-project.iam.gserviceaccount.com","client_id":"...","auth_uri":"https://accounts.google.com/o/oauth2/auth","token_uri":"https://oauth2.googleapis.com/token","auth_provider_x509_cert_url":"https://www.googleapis.com/oauth2/v1/certs","client_x509_cert_url":"https://www.googleapis.com/robot/v1/metadata/x509/firebase-adminsdk-xxxxx%40your-project.iam.gserviceaccount.com"}

# Backblaze B2 (photo/report storage). Mirror of local.properties — the Android app
# reads B2_* from local.properties (BuildConfig); keep both in sync.
B2_APPLICATION_KEY_ID=your-b2-key-id
B2_APPLICATION_KEY=your-b2-application-key
B2_BUCKET_NAME=your-b2-bucket-name

# Groq AI for advisory and chat (optional). Get an API key from https://console.groq.com.
# Without it the AI advisory routes will gracefully degrade and return null.
GROQ_API_KEY=your-groq-api-key

# ── Session tokens (custom auth — replaces Firebase Auth) ──────────────────
# Secret used to sign login session tokens (HMAC-SHA256). Generate with:
#   openssl rand -hex 32
# Optional: when unset, a value is derived from ADMIN_SECRET (works, but set
# an explicit secret in production).
SESSION_SECRET=

# ── Email OTP delivery (6-digit codes for registration / login) ────────────
# MAIL_MODE=log  → prints emails to the server console (development).
# MAIL_MODE=smtp → sends via SMTP below. For Gmail create an App Password:
#   Google Account → Security → 2-Step Verification → App passwords.
MAIL_MODE=log
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your@gmail.com
SMTP_PASS=your-gmail-app-password
MAIL_FROM="PashuRakshak <your@gmail.com>"

# OTP debug page at GET /otp — shows every code emailed (or attempted) so you
# can test flows while SMTP is broken. Requires ?key=<ADMIN_SECRET> unless
# OTP_PAGE_OPEN=true. Set OTP_PAGE=false to disable the route entirely.
OTP_PAGE=true
OTP_PAGE_OPEN=false

