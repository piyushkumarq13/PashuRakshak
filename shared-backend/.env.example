# Copy this file to .env and fill in real values. Never commit .env.
# On Render / Vercel add these as Environment Variables in the dashboard instead.

# ── Database (Turso) ───────────────────────────────────────────────────────
# libsql://… for production; file:local.db is fine for local development.
TURSO_DATABASE_URL=libsql://your-db-name.turso.io
TURSO_AUTH_TOKEN=your-turso-auth-token

# ── Server ─────────────────────────────────────────────────────────────────
# Optional. Render sets PORT automatically; Vercel does not need it.
# PORT=3000

# Comma-separated browser origins allowed by CORS.
# Local: 5173 = vet-registration, 5174 = gov-portal, 3000 = backend.
# Production: use "*" while Vercel preview URLs keep changing, or list your
# exact URLs, e.g. https://gov-portal.vercel.app,https://vet-registration.vercel.app
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:5174

# Shared secret for admin-only core routes (X-Admin-Secret header).
# Generate with: openssl rand -hex 32
ADMIN_SECRET=change-me-to-a-long-random-string

# HMAC secret for session/verify tokens. REQUIRED in production (NODE_ENV=production).
# Generate with: openssl rand -hex 32
SESSION_SECRET=change-me-to-another-long-random-string

# ── Firebase (FCM push only — login does NOT use Firebase) ─────────────────
# One-line service-account JSON from Firebase Console → Project Settings →
# Service Accounts → Generate new private key. Must match the Android app's
# google-services.json project. Optional: without it, push helpers skip.
FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"your-project","private_key_id":"...","private_key":"-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n","client_email":"firebase-adminsdk-xxxxx@your-project.iam.gserviceaccount.com","client_id":"...","auth_uri":"https://accounts.google.com/o/oauth2/auth","token_uri":"https://oauth2.googleapis.com/token","auth_provider_x509_cert_url":"https://www.googleapis.com/oauth2/v1/certs","client_x509_cert_url":"https://www.googleapis.com/robot/v1/metadata/x509/firebase-adminsdk-xxxxx%40your-project.iam.gserviceaccount.com"}

# ── Backblaze B2 (photo/report storage) ────────────────────────────────────
B2_APPLICATION_KEY_ID=your-b2-key-id
B2_APPLICATION_KEY=your-b2-application-key
B2_BUCKET_NAME=your-b2-bucket-name

# ── Groq AI (optional) ─────────────────────────────────────────────────────
GROQ_API_KEY=your-groq-api-key

# ── Email OTP delivery ─────────────────────────────────────────────────────
# MAIL_MODE:
#   log    → print codes to the server console (development).
#   smtp   → Gmail SMTP with an App Password. Works on Vercel and local, but
#            Render Free blocks outbound SMTP ports 25/465/587.
#   brevo  → Brevo HTTPS API (works on Render Free). Set BREVO_API_KEY.
#   resend → Resend HTTPS API (works on Render Free). Set RESEND_API_KEY.
#   auto   → Brevo → Resend → SMTP → log (first one configured).
MAIL_MODE=log

# SMTP (only used when MAIL_MODE=smtp, or as auto fallback)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your@gmail.com
SMTP_PASS=your-gmail-app-password

# HTTPS providers (recommended for Render Free)
# Brevo: https://app.brevo.com → SMTP & API → API Keys. Verify MAIL_FROM as a sender.
BREVO_API_KEY=
# Resend: https://resend.com → API Keys. MAIL_FROM must use a verified domain.
RESEND_API_KEY=

# Sender shown to recipients. For Brevo/Resend this address must be verified.
MAIL_FROM="PashuRakshak <your@gmail.com>"

# ── OTP debug page (keep disabled in production) ───────────────────────────
# GET /otp?key=<ADMIN_SECRET> shows recent codes. OTP_PAGE_OPEN=true only works
# outside production.
OTP_PAGE=false
OTP_PAGE_OPEN=false
