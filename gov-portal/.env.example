# ── Government Portal (Vite) ───────────────────────────────────────────────
# Copy this file to `.env` for local development, or add the same variables in
# Vercel → Project → Settings → Environment Variables (Production + Preview).
# Vite bakes VITE_* values into the build, so redeploy after changing them.

# Backend API URL (no trailing slash).
VITE_API_BASE_URL=https://pashurakshak-ilol.onrender.com

# API key issued by the backend when this app was registered:
#   POST /api/v1/core/apps  { "name": "Government Portal" }
#   Header: X-Admin-Secret: <ADMIN_SECRET>
# The apiKey is shown only once.
VITE_APP_API_KEY=
